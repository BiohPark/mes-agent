{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git pull)",
      "PowerShell(.\\test.ps1)",
      "PowerShell(.\\test.ps1 *)",
      "Bash(conda run -n mes-agent python -m pytest *)",
      "Bash(conda run -n mes-agent pytest *)",
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "PowerShell(pytest *)",
      "PowerShell(python -m pytest *)",
      "PowerShell(python *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-mes-agent-env.mjs\"",
            "timeout": 8
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "git diff --name-only HEAD 2>/dev/null | grep -q 'agent/tools/' && echo '[hook] 툴 파일 변경됨 — smoke test: conda run -n mes-agent pytest tests/smoke/ -q' || true"
          }
        ]
      }
    ]
  }
}
