# ── 개발 환경 경로 ────────────────────────────────────
NODE_VERSION=22.22.3
CONDA_ENV=mes-agent
NVM_HOME=C:\users\qldh1\AppData\Local\nvm
NVM_SYMLINK=C:\nvm4w\nodejs
MINICONDA_HOME=D:\programs\miniconda3

# ── LLM 설정 ─────────────────────────────────────────
LLM_ACTIVE=openai

LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_MODEL=gpt-5.4-nano
# 헤더 모델 드롭다운 프리셋 (콤마 구분). /v1/models 동적 조회 실패 시 폴백으로 사용
LLM_OPENAI_MODELS=gpt-5.4-nano,gpt-4o,gpt-4o-mini,gpt-4.1,o3-mini

LLM_INTERNAL_BASE_URL=http://사내LLM주소/v1
LLM_INTERNAL_MODEL=사내모델명
# 사내 LLM 모델 프리셋 (콤마 구분)
LLM_INTERNAL_MODELS=사내모델명,사내모델명-mini

# 한 요청에 보낼 도구 최대 개수 (OpenAI 호환 API의 tools 배열 한계는 128).
# 등록 도구가 더 많으면 요청마다 관련도 상위 N개만 전송한다. 한계가 다른 LLM이면 조정.
LLM_MAX_TOOLS=128

# ── 모델별 컨텍스트 예산 (백로그 M5) ──────────────────────────
# 컨텍스트 윈도우(토큰)는 모델마다 다르다. known 모델(gpt-4o=128k 등)은 자동 인식하지만,
# gpt-5.4-nano 같은 신규/사내 모델은 실제 윈도우를 여기서 지정하는 것을 권장한다(없으면 폴백 128k).
# 프로파일별 LLM_{PROFILE}_CONTEXT_TOKENS 로 지정 — 활성 프로파일 값이 우선한다.
# LLM_OPENAI_CONTEXT_TOKENS=128000
# LLM_INTERNAL_CONTEXT_TOKENS=32000
# 미지 모델 전체에 적용할 폴백(기본 100000). 보수적으로 낮춰 더 일찍 압축한다.
# LLM_DEFAULT_CONTEXT_TOKENS=100000

# 컨텍스트가 이 비율을 넘으면 중간 대화를 요약해 압축한다. 기본 0.7.
# 사내/vLLM 호환성을 위해 요약은 첫 system 메시지에 병합되며, 중간 system 메시지를 만들지 않는다.
COMPACT_RATIO=0.7

# ── API 키 (터미널 환경변수 주입 권장) ────────────────────
# cmd: set OPENAI_API_KEY=sk-...
#      set INTERNAL_API_KEY=...
#	   set OBSIDIAN_API_KEY=...
# 또는 .env에 직접 기입 (git push 주의)

# ── Agent 서버 ────────────────────────────────────────
AGENT_PORT=8000
# AGENT_AUTH_TOKEN 은 Electron(main.js)이 실행마다 자동 생성·주입합니다(수동 설정 불필요).
# 직접 python -m agent.server 로 띄울 때 설정하면 해당 토큰을 요구합니다(미설정 시 미강제).

# 서버 바인딩 호스트. 기본 127.0.0.1(로컬 전용, 보안 기본값) — 바꾸지 마세요.
# LAN 노출은 백로그 O(B) 미착수 항목이며 추가 인증 강화 없이 0.0.0.0으로 바꾸면 위험합니다.
# AGENT_HOST=127.0.0.1

# (선택) get_system_info 디스크 사용량 조회 경로. 기본 C:\ (Windows 가정)
# SYSTEM_DISK_PATH=C:\

# ── 브라우저 (Office Online 등) ───────────────────────────
# 실제 Microsoft Edge로 구동하려면 msedge (사내 SSO·Office Online 호환 ↑). 비우면 Chromium.
# BROWSER_CHANNEL=msedge
# 브라우저 열기/이동 시 사용자 작업 포커스를 빼앗을지(백로그 I). 기본 false=비탈취(작업 후 사용자 창 복원).
# true면 브라우저를 전면화(키보드 조작 디버깅 등에 편함).
BROWSER_FOCUS_STEAL=false

# ── 사내 문서 포털 / SharePoint (회사에서 실제 URL 확인 후 기입) ──
# 사내 SharePoint/포털의 기본 주소. office_web_open에 상대경로를 주면 이 값을 앞에 붙인다.
# 예: 문서를 평소 여는 브라우저 주소의 호스트 부분 (https://xxxxxxxxx.sharepoint.com)
# SHAREPOINT_BASE_URL=

# ── LibreOffice (MS Office 미설치 시 오프라인 변환 폴백) ──────────
# 표준 경로 자동 탐지. 비표준 설치 시에만 지정.
# LIBREOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe

# ── MS Graph (M365 클라우드 Excel 편집, 선택) ───────────────────
# Azure AD 액세스 토큰(Files.ReadWrite). 설정 시 graph_* 클라우드 Excel 툴 활성화.
# GRAPH_ACCESS_TOKEN=eyJ0eXAiOi...
# 사내 전용/Sovereign M365는 그래프 엔드포인트가 다를 수 있어 base URL 재정의(공개 기본값: graph.microsoft.com)
# GRAPH_BASE_URL=https://graph.사내도메인/v1.0

# ── UI Automation ──────────────────────────────
# 화면 인식 제공자 선택(어댑터). 기본 uia (UI Automation).
OCR_PROVIDER=uia
OCR_LANG=kor+eng

# ── Obsidian ──────────────────────────────────────────
OBSIDIAN_VAULT_PATH=D:/archive/obsidian/brain
OBSIDIAN_HOST=https://127.0.0.1:27124

# ── 장기기억 (대화 간) ─────────────────────────────────────
# true면 과거 대화에서 사실·선호·결정을 자동 추출하고, 새 대화에 관련 기억을 주입합니다.
# 저장 위치: <OBSIDIAN_VAULT_PATH>/agent/memory/long_term.md. 끄려면 false.
MEMORY_ENABLED=true
# 자동 추출 타이밍: close(스레드 종료 시 1회 일괄 — 비용↓, 기본) | turn(매 턴) | off(자동 추출 끔)
# off 여도 명시적 memory_remember/forget/recall 도구와 🧠 기억 관리 UI는 동작합니다.
MEMORY_EXTRACT_MODE=close

# ── Vision (멀티모달 화면 분석) ───────────────────────────
# capture_screen(메인 LLM이 화면을 직접 봄) / analyze_screen / analyze_region 툴을 켭니다.
# 사내 멀티모달 LLM이 확인되어 기본값은 true 입니다.
# 비전 미지원 모델을 쓸 때만 false 로 끄세요 (이미지 입력 시 API 오류 방지).
VISION_ENABLED=true

# ── 이미지 토큰 다이어트 (백로그 M1) ─────────────────────────
# capture_screen 으로 주입하는 화면 이미지의 토큰·페이로드 비용을 낮춰 컨텍스트 초과를 예방합니다.
# 긴 변이 이 픽셀을 넘으면 비율 유지 축소(0/음수면 비활성). 1568 권장(멀티모달 인식 손실 최소).
VISION_MAX_EDGE=1568
# 주입 이미지 인코딩: jpeg(작음, 권장) 또는 png(무손실, 큼).
VISION_IMAGE_FORMAT=jpeg
# JPEG 품질(1~95). 낮을수록 작지만 화질 저하.
VISION_JPEG_QUALITY=80
# 이미지 detail 수준: auto | high | low | off. off 는 detail 필드 자체를 빼서 미지원 엔드포인트 대비.
# 평상시 이 값을 쓰고, 컨텍스트가 임계에 근접하면 자동으로 low 로 강등합니다(적응형).
VISION_DETAIL=auto
# 대화 히스토리에 유지할 최신 화면 이미지 개수(M2). 더 오래된 캡처는 텍스트 자리표시자로 치환해
# 누적 이미지가 컨텍스트를 잠식하는 것을 막습니다. 0 이면 직전 캡처도 즉시 정리.
VISION_KEEP_LAST_IMAGES=2
# 컨텍스트 초과(400)로 LLM 호출이 거부될 때 payload를 줄여 재시도하는 최대 횟수(M4).
# 1차=이미지 축소, 2차=대화 요약 압축. 소진 시 친절한 안내 후 종료(전면 실패 방지·모델 무관).
MAX_OVERFLOW_RETRY=2

# ── 협업모드(코치) (백로그 H) ─────────────────────────────
# 주기 틱에서 직전 화면 대비 평균 변화율이 이 값 미만이면 LLM 호출 없이 건너뜀(비용 절감).
# 0~1, 클수록 큰 변화에만 반응. 클라이언트 폴링 주기는 30초(고정).
COLLAB_CHANGE_THRESHOLD=0.08

# ── MCP 클라이언트 (백로그 J) ─────────────────────────────
# 외부 MCP 서버(예: Oracle DB) 도구를 에이전트 도구로 노출. 설정 파일이 없으면 비활성(무해).
# 설정: mcp_servers.json.example → mcp_servers.json 으로 복사해 채움(실파일은 git 제외). 폐쇄망=stdio 권장.
MCP_ENABLED=true
MCP_CONFIG=mcp_servers.json

# ── 도메인 하네스(백로그 N, 업무타입별 옵트인 자기검증) ─────────────
# true면 task_type 설정의 harness/verify_prompt가 있는 업무(예: syncade)에서
# Executor→Reviewer 자기교정 루프가 동작한다(/chat harness_mode=true 또는 업무 설정 옵트인). 기본 false.
HARNESS_ENABLED=false
# Reviewer에게 함께 보낼 최근 화면 캡처 이미지 개수(멀티모달 검증). 0이면 텍스트만 전달.
HARNESS_REVIEWER_IMAGES=2

# ── Vault 매개 원격 제어(명령함, 백로그 O) ─────────────────
# 포트 개방 없이 동기화되는 Obsidian Vault 파일로 원격 제어. 기본 비활성(opt-in).
# 켜면 서버가 agent/control/inbox.md 를 폴링해 "- [ ] 명령" 을 실행하고
# 결과를 agent/control/status.md 에 적는다. 무인 환경이라 위험·쓰기 작업은 자동 거부된다.
CONTROL_ENABLED=false
CONTROL_POLL_INTERVAL=5

# ── 도구 타임아웃(무한 행 방지·작업 가시성) ───────────────────
# 어떤 도구도 이 시간(초)보다 오래 SSE를 막지 못하는 디스패치 하드 캡. 도구별 작은 baseline에서
# 시작해 단계적으로 늘려가며 같은 작업을 더 기다리고, 캡 도달 시 구조화된 타임아웃 오류로 마감합니다.
TOOL_TIMEOUT_CAP=90
# MS Office(COM) 자체 타임아웃(초). 캡보다 짧게 → Office가 먼저 멈춘 인스턴스를 자가복구(우리 인스턴스만 종료).
OFFICE_COM_TIMEOUT=45
# (선택) 도구별 예상시간 override — JSON {도구명: 초}. 예: {"run_command": 3, "excel_set_cells": 20}
# TOOL_BASELINE_OVERRIDES=

# PlayWright
PLAYWRIGHT_BROWSERS_PATH=%USERPROFILE%\AppData\Local\ms-playwright
